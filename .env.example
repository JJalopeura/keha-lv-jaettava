# Sovellus käynnistyy oletuksena ilman verkkoyhteyksiä mock-LLM:llä.
KEHA_LV_LLM_PROVIDER=mock
KEHA_LV_DEMO_MODE=true
KEHA_LV_FORCE_MOCK_LLM=true
KEHA_LV_LLM_MIN_INTERVAL_S=0

# Oikeaa Azure OpenAI -yhteyttä varten vaihda provider arvoon azure ja täytä
# nämä omilla organisaation tunnuksillasi. Älä lisää oikeaa .env-tiedostoa git:iin.
AZURE_OPENAI_HOST_CORE=https://your-resource.openai.azure.com
AZURE_OPENAI_HOST_CHAT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY_CORE=<replace-with-your-core-key>
AZURE_OPENAI_API_KEY_CHAT=<replace-with-your-chat-key>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MODEL_CORE=replace-with-your-deployment-name
AZURE_OPENAI_MODEL_CHAT=replace-with-your-deployment-name
