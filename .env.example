# KEHA LV — live Azure AI Foundry configuration.
#
# This build has no mock/offline LLM and no demo seeding: every AI call goes to
# the Azure AI Foundry deployment configured here. Copy this file to `.env` and
# fill in real values; `.env` is gitignored and must never be committed.

# Signing key for the browser session cookie. Use a long random value.
# If unset, a random per-process key is generated (sessions end on restart).
KEHA_LV_SESSION_SECRET=

# Azure AI Foundry endpoint. Both the account endpoint
# (https://<resource>.services.ai.azure.com) and a project endpoint
# (https://<resource>.services.ai.azure.com/api/projects/<project>) work; the
# client uses the OpenAI-compatible /openai/v1 surface.
AZURE_OPENAI_HOST_CORE=https://foundry-ecdx-cs-proto.services.ai.azure.com
AZURE_OPENAI_HOST_CHAT=https://foundry-ecdx-cs-proto.services.ai.azure.com
# API key from the Foundry resource (Keys and Endpoint). Prefer a managed
# identity / Key Vault reference in production.
AZURE_OPENAI_API_KEY_CORE=
AZURE_OPENAI_API_KEY_CHAT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment names, not model ids.
#   core = high-volume JSON work: field suggestions, intake, structure extraction, checks
#   chat = conversational prose: contextual chat, summaries, memos
AZURE_OPENAI_MODEL_CORE=DeepSeek-V4-Flash
AZURE_OPENAI_MODEL_CHAT=gpt-6-luna

AZURE_OPENAI_TIMEOUT_S_CORE=120
AZURE_OPENAI_TIMEOUT_S_CHAT=120

# Minimum spacing between LLM calls across the process (seconds). Raise it when
# several insight jobs run at once against a throttled deployment.
KEHA_LV_LLM_MIN_INTERVAL_S=0

# Optional: company-wide vector store ids (comma separated).
KEHA_LV_COMPANY_VECTOR_STORE_IDS=

# Deterministic agent fallbacks. Off by default so a canned answer can never
# mask a failed Foundry call. Enable only for a known-degraded deployment.
KEHA_LV_ALLOW_FALLBACK=false
